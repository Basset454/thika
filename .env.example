# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (pooler or direct).
# Format: postgresql://username:password@ep-xxxx.neon.tech/neondb?sslmode=require
# Automatically provided by Neon integration or configured in Vercel project environment variables.
DATABASE_URL="postgresql://username:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# BLOB_READ_WRITE_TOKEN: Token from Vercel Blob store (test23-blob).
# Automatically provided in Vercel when you attach a Blob store to your project.
# Used exclusively for uploading and hosting high-definition product imagery.
# Format: vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ADMIN_PASSWORD: Required administrator password for /admin portal.
# Must be set in local .env and Vercel project environment variables.
# Do NOT commit actual secrets. Fails closed if not configured.
ADMIN_PASSWORD="your-strong-admin-password"

# VITE_GOOGLE_MAPS_API_KEY: Optional client-side API key for Google Maps Embed API.
# If omitted, the storefront seamlessly uses the zero-config Google Maps embed fallback.
# Must be a browser key restricted by HTTP referrer in Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."
